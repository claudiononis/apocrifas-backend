projection;
strict ( 2 );
use draft;
define behavior for ZC_APOC_RUN alias Run
{
  use create; use update; use delete; use action refresh;
  use action Edit; use action Activate; use action Discard; use action Resume; use action Prepare;
  use association _Log { create; with draft; }
  side effects { action refresh affects field Estado, field TotalRegistros, field TotalValidos, field TotalMatch, field TotalBloqueables, field TotalNoEncontrados, field TotalErrores, entity _Log; }
}
define behavior for ZC_APOC_LOG alias Log
{
  use update; use delete; use association _Run { with draft; }
}
