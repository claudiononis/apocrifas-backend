managed with additional save implementation in class zbp_i_apoc_run unique;
strict ( 2 );
with draft;

define behavior for ZI_APOC_RUN alias Run
persistent table zapoc_run
draft table zapoc_run_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LastChangedAt
{
  create; update; delete;
  action refresh;
  determination setInitialStatus on save { create; }
  field ( readonly ) RunId, Estado, TotalRegistros, TotalValidos, TotalMatch, TotalBloqueables, TotalNoEncontrados, TotalErrores, MensajeError, CreatedBy, CreatedAt, LastChangedAt;
  field ( numbering : managed ) RunId;
  association _Log { create; with draft; }
  draft action Edit; draft action Activate optimized; draft action Discard; draft action Resume; draft determine action Prepare;
  mapping for zapoc_run
  {
    RunId              = run_id;
    ModoTest           = modo_test;
    Estado             = estado;
    Contenido          = contenido;
    FileContent        = file_content;
    MimeType           = mime_type;
    FileName           = file_name;
    TotalRegistros     = total_registros;
    TotalValidos       = total_validos;
    TotalMatch         = total_match;
    TotalBloqueables   = total_bloqueables;
    TotalNoEncontrados = total_no_encontr;
    TotalErrores       = total_errores;
    MensajeError       = mensaje_error;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedAt      = last_changed_at;
  }
}

define behavior for ZI_APOC_LOG alias Log
persistent table zapoc_log
draft table zapoc_log_d
lock dependent by _Run
authorization dependent by _Run
etag dependent by _Run
{
  update; delete;
  field ( readonly ) RunId, LineNumber;
  association _Run { with draft; }
  mapping for zapoc_log
  {
    RunId      = run_id;
    LineNumber = line_number;
    Cuit       = cuit;
    Supplier   = supplier;
    Resultado  = resultado;
    Mensaje    = mensaje;
    CreatedAt  = created_at;
  }
}

